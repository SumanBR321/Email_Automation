# Environment Configuration
ENV=development
APP_HOST=127.0.0.1
APP_PORT=8001
SECRET_KEY=change_this_to_a_secure_random_string

# Provider Configuration: 'mock', 'smtp', or 'unitpost'
EMAIL_PROVIDER=mock

# SMTP Relay Configuration (e.g., Gmail smtplib - no domain required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Apex Talent Partners"

# Unitpost Credentials (Send & Contacts scoped key, never full-access)
UNITPOST_API_KEY=pk_test_placeholder
UNITPOST_WEBHOOK_SECRET=whsec_placeholder
UNITPOST_FROM_EMAIL=notices@agency.example.com
UNITPOST_TOPIC_ID=

# Safety & Compliance Rules
# Comma-separated list of permitted recipients when ENV != production
TEST_ALLOWLIST=tester@agency.example.com,admin@agency.example.com

# Agency Mandatory Footer Information (CAN-SPAM / Legal Compliance)
AGENCY_NAME="Apex Talent Partners"
AGENCY_POSTAL_ADDRESS="100 Montgomery St, Suite 1500, San Francisco, CA 94104"

# Throttling & Batch Limits (Free Tier Protection)
DAILY_LIMIT=200
BATCH_SIZE=50

# Database URL (SQLite for prototype, Postgres-ready)
DATABASE_URL=sqlite:///./vendor_email.db
